@article{shah2026cropland,
  title     = {Assessing the Impacts of Urbanization and Climate Variability on Cropland Dynamics and Food Security in Punjab, Pakistan (2000--2025): A Multi-Scale Remote Sensing and Machine Learning Approach},
  author    = {Shah, Adnan Abbas},
  journal   = {Environmental Monitoring and Assessment},
  volume    = {198},
  pages     = {700},
  year      = {2026},
  publisher = {Springer},
  doi       = {10.1007/s10661-026-15529-1},
  url       = {https://link.springer.com/article/10.1007/s10661-026-15529-1},
  html      = {https://link.springer.com/article/10.1007/s10661-026-15529-1},
  preview   = {pub_cropland.jpg},
  abstract  = {District-scale cropland and built-up change across Punjab from 2000 to 2025 using multi-resolution land cover data, ERA5-Land and GLDAS-2.2 reanalyses, and Google Earth Engine. Cropland declined 12.30% while built-up area expanded 180.31%. Groundwater storage declined significantly, and a Random Forest model explained 92.96% of cropland variance, pointing to urbanization, climate variability and water balance stress as the dominant drivers of food security risk.},
  selected  = {true},
  bibtex_show = {true}
}

@article{abid2026weap,
  title     = {Analyzing Water Demand and Supply Under Socioeconomic and Climate Change Scenarios Using WEAP: A Case Study of Kabul River Basin, Pakistan},
  author    = {Abid, Humaira and Iqbal, Javed and Shah, Adnan Abbas and Zafar, Aiman},
  journal   = {Water Conservation Science and Engineering},
  volume    = {11},
  pages     = {84},
  year      = {2026},
  publisher = {Springer},
  doi       = {10.1007/s41101-026-00549-2},
  url       = {https://link.springer.com/article/10.1007/s41101-026-00549-2},
  html      = {https://link.springer.com/article/10.1007/s41101-026-00549-2},
  pdf       = {https://link.springer.com/content/pdf/10.1007/s41101-026-00549-2.pdf},
  preview   = {pub_weap.jpg},
  abstract  = {Current and future water supply-demand dynamics in the Lower Kabul River Basin modelled in WEAP under socioeconomic growth and RCP 4.5 and RCP 8.5 for 2023-2050. Domestic and agricultural demand rise and unmet demand grows, but efficient irrigation and improved management offer substantial mitigation potential aligned with SDG 6.},
  selected  = {true},
  bibtex_show = {true}
}

@article{shah2026desertification,
  title     = {Spatiotemporal Assessment of Desertification Sensitivity in Ningxia, China, Using the MEDALUS Framework and Random Forest Classification (2001--2022)},
  author    = {Nawaz, Munaza and Kalisa, Wilson and Zaheen, Zakria and Tauqir, Moughal and Zhang, Jiahua and Shah, Adnan Abbas and Ullah, Kalim},
  journal   = {Journal of Geoscience and Earth Observation},
  volume    = {1},
  number    = {1},
  pages     = {39--54},
  year      = {2026},
  doi       = {10.62762/JGEO.2025.205415},
  url       = {https://www.icck.org/article/abs/jgeo.2025.205415},
  html      = {https://www.icck.org/article/abs/jgeo.2025.205415},
  pdf       = {https://www.icck.org/article/epdf/jgeo/6107},
  preview   = {pub_ningxia.jpg},
  abstract  = {MEDALUS framework combined with a Random Forest classifier to map desertification vulnerability in Ningxia from 2001 to 2022. Farmland expanded to 65.29% of the landscape, grassland shrank to 10.13%, and bare land followed a U-shaped trend reaching 9.17% in 2022. High-desertification areas persisted across 9,552 square kilometres, concentrated in northern and central Ningxia.},
  bibtex_show = {true}
}

@article{ali2026waterbudget,
  title     = {Hydrometeorological Assessment of Water Budget Components in Rawalpindi Division, Pakistan: An ERA5 Reanalysis and Machine Learning Approach},
  author    = {Ali, Owais and Ahmad, Junaid and Shah, Adnan Abbas and Sohail, Mudassir},
  journal   = {Journal of Nautical Eye and Strategic Studies},
  year      = {2026},
  doi       = {10.58932/MULG0076},
  url       = {https://scholar.google.com/citations?view_op=view_citation&hl=en&user=D7YV-1wAAAAJ&citation_for_view=D7YV-1wAAAAJ:2osOgNQ5qMEC},
  preview   = {pub_waterbudget.jpg},
  abstract  = {Water budget dynamics of Rawalpindi Division assessed with ERA5 reanalysis, GIS, remote sensing, SCS-CN runoff estimation, Mann-Kendall trend analysis and linear regression. Across 131 months, precipitation, evapotranspiration, runoff, soil moisture and storage change show strong monsoon-driven variability, high evapotranspiration losses, and declining runoff and soil moisture.},
  bibtex_show = {true}
}

@inproceedings{shah2024flood,
  title     = {Flood Susceptibility Mapping in District Jhang Using Remote Sensing and Advanced Machine Learning Techniques},
  author    = {Shah, Adnan Abbas and Iqbal, Muhammad Farooq},
  booktitle = {2024 IEEE 23rd International Conference on Frontiers of Information Technology (FIT)},
  year      = {2024},
  publisher = {IEEE},
  url       = {https://ieeexplore.ieee.org/document/10838394/},
  html      = {https://ieeexplore.ieee.org/document/10838394/},
  pdf       = {https://github.com/adnanabbasshah/Publications/blob/main/Flood_Susceptibility_Mapping_in_District_Jhang_Using_Remote_Sensing_and_Advanced_Machine_Learning_Techniques_2.pdf},
  preview   = {pub_flood_jhang.jpg},
  abstract  = {Six machine learning models (RNN, ANN, RF, MLP, SVM, KNN) trained on Landsat, Sentinel-2, SRTM, CHIRPS and Dynamic World data to map flood susceptibility across District Jhang. KNN and RNN reached the highest accuracy (AUC = 0.99), and 27.2 to 39% of the study area falls in high to very high susceptibility classes. A Google Earth Engine web app was built for interactive visualization.},
  selected  = {true},
  bibtex_show = {true}
}

@unpublished{shah2026cdhw,
  title     = {Compound Drought and Heatwave Events over Pakistan (1981--2025): Observed Trends, Coupling Mechanisms, and Future Projections under CMIP6 Scenarios},
  author    = {Shah, Adnan Abbas and Abbas, Aon and Khalid, Muhammad and Syed, Jabir Hussain},
  note      = {Under review, Environmental Monitoring and Assessment (Springer)},
  year      = {2026},
  pdf       = {https://drive.google.com/file/d/1x87HpXFPO5TKgxThMSlzzotUfpCibafW/view?usp=drive_link},
  preview   = {pub_cdhw.jpg},
  abstract  = {Compound drought-heatwave events across Pakistan characterized with ERA5-Land, CHIRPS, MODIS LST and vegetation indices, LandScan 2020, and a five-model CMIP6 ensemble under SSP2-4.5 and SSP5-8.5. National heatwave occurrence rose 23.6% (27.1 to 33.5 days per year; Sen's slope +5.79 days per decade). CDHW intensity increased 64.1% per decade and drought-heatwave coupling explained 90.8% of compound-event formation. Currently 98.6 million people and 40,643 square kilometres of cropland are exposed to extreme heatwave conditions, with occurrence projected to reach 247.1 days per year by 2076-2100 under SSP5-8.5.},
  selected  = {true}
}

@unpublished{shah2026jhelum,
  title     = {Entropy-Based Characterization of Drought and Climate Change Amplification in the Jhelum River Basin, Pakistan (1981--2024)},
  author    = {Shah, Adnan Abbas},
  note      = {Under review, Hydrological Sciences Journal},
  year      = {2026},
  pdf       = {https://github.com/adnanabbasshah/Publications/blob/main/HSJ-2026-0325_Proof_hi.pdf},
  preview   = {pub_jhelum.png},
  abstract  = {Shannon-entropy rainfall variability integrated with SPI, SPEI and SRI across 209 grid cells to identify drought hotspots and an eastern rain-shadow belt in the Jhelum Basin. Roughly 52% of the basin is drought-vulnerable, and a significant SPEI-SPI gap trend evidences warming-driven drought amplification.},
  selected  = {true}
}
